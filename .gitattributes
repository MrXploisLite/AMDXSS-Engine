# Normalize line endings in the repository (LF in the working tree for source;
# CRLF only where Windows tooling requires it).
* text=auto eol=lf

# Windows-native artifacts need CRLF to run correctly.
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Explicit source types.
*.py   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf

# Never touch binaries.
*.png  binary
*.jpg  binary
*.zip  binary
*.dll  binary
*.exe  binary
