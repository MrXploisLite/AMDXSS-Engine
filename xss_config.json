{
  "engine_name": "AMD XSS Engine",
  "version": "1.0.0",
  "poll_seconds": 5,
  "idle_to_eco_minutes": 0,
  "min_switch_interval_seconds": 30,
  "_idle_to_eco_note": "0 disables the idle rule. Set e.g. 10 to fall back to eco after N minutes without user input.",
  "profiles": {
    "eco": {
      "scheme": "AMD Engine - Eco",
      "chill": { "enabled": true, "min": 30, "max": 60 },
      "frtc":  { "enabled": false, "fps": 60 },
      "sharpening": { "enabled": false },
      "antilag": { "enabled": false },
      "enhanced_sync": { "enabled": false }
    },
    "balanced": {
      "scheme": "AMD Engine - Balanced",
      "chill": { "enabled": true, "min": 60, "max": 120 },
      "frtc":  { "enabled": false, "fps": 60 },
      "sharpening": { "enabled": true, "sharpness": 80 },
      "antilag": { "enabled": false },
      "enhanced_sync": { "enabled": false }
    },
    "performance": {
      "scheme": "AMD Engine - Performance",
      "chill": { "enabled": false, "min": 75, "max": 140 },
      "frtc":  { "enabled": false, "fps": 60 },
      "sharpening": { "enabled": true, "sharpness": 80 },
      "antilag": { "enabled": true },
      "enhanced_sync": { "enabled": false }
    },
    "stock": {
      "scheme": "Balanced",
      "chill": { "enabled": false, "min": 75, "max": 140 },
      "frtc":  { "enabled": false, "fps": 60 },
      "sharpening": { "enabled": false },
      "antilag": { "enabled": false },
      "enhanced_sync": { "enabled": false }
    }
  },
  "rules": {
    "_comment": "Process-name patterns (case-insensitive globs) matched against the foreground window's executable.",
    "games": [
      "cs2.exe",
      "VALORANT.exe",
      "FortniteClient-Win64-Shipping.exe",
      "javaw.exe",
      "RobloxPlayerBeta.exe"
    ],
    "_games_note": "Add the executables of your own games here (case-insensitive, * wildcards allowed).",
    "calls": [
      "Discord.exe",
      "Zoom.exe",
      "Teams.exe",
      "ms-teams.exe",
      "WhatsApp.exe",
      "Telegram.exe",
      "Skype.exe",
      "LINE.exe"
    ],
    "game_profile": "performance",
    "call_profile": "eco",
    "idle_profile": "eco",
    "default_profile": "balanced"
  },
  "os_tuning": {
    "_comment": "Generic OS layer: boost the focused process, calm loud background ones. No per-app lists.",
    "enabled": true,
    "debounce": true,
    "boost_foreground": true,
    "restore_previous": true,
    "calm_background": false,
    "calm_budget_seconds": 8.0,
    "calm_exclude": []
  }
}
